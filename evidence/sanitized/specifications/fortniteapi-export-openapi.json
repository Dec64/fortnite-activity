{
  "openapi": "3.0.1",
  "info": {
    "title": "Export Service",
    "description": "This export service is powered by [CUE4Parse](https://github.com/FabianFG/CUE4Parse), an open-source Unreal Engine asset parser. It automatically updates to the latest version of the game whenever a new manifest is released, ensuring the data is always up to date.\r\nThe service also holds a few older versions of the game, so you can get \"back in time\". We try to preserve the latest version of every major.\r\n\r\n**Note:** This service is currently in **beta** and may be subject to **breaking changes** as development continues.\r\n\r\n\r\n**Disclaimer:** This project is **not affiliated with, endorsed, sponsored, or approved by Epic Games** in any way. It is intended solely for educational and informational purposes. **Using this service to exploit, abuse, or modify game files is strictly prohibited.**",
    "contact": {
      "name": "FortniteAPI.com Discord",
      "url": "https://discord.com/invite/xsgAFhS"
    },
    "version": "v1"
  },
  "paths": {
    "/v1/aes": {
      "get": {
        "tags": [
          "Aes"
        ],
        "summary": "Returns all the AES keys that are currently in the system.",
        "parameters": [
          {
            "name": "Version",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/aes/{pakId}": {
      "get": {
        "tags": [
          "Aes"
        ],
        "summary": "Lists the files of a PAK.",
        "description": "Returns a list with all matching AES keys, including all the file paths that are in this pak.",
        "parameters": [
          {
            "name": "pakId",
            "in": "path",
            "description": "Either the Pak ID as int (eg 1012 of 1020) or the Pak ID as string.",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Version",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/aes/{pakId}/cosmetics": {
      "get": {
        "tags": [
          "Aes"
        ],
        "summary": "Lists the parsed cosmetics and bundles of a PAK.",
        "description": "This endpoint lists the cosmetics and bundles inside the requested pak. The cosmetics and bundles are parsed via our export parse endpoint (/v1/export/parsed).",
        "parameters": [
          {
            "name": "pakId",
            "in": "path",
            "description": "Either the Pak ID as int (eg 1012 of 1020) or the Pak ID as string.",
